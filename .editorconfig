# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# 中文段落折行由编辑器决定，不做强制
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
